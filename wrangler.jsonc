{
  "name": "cardbox",
  "compatibility_date": "2026-11-01",
  // Files in dist are served as they are; anything else (just /turn) runs the Worker.
  "main": "worker/index.js",
  "assets": { "directory": "./dist", "binding": "ASSETS" },
  "routes": [{ "pattern": "cardbox.claws.blue", "custom_domain": true }],
  // The home server's TURN relay (coturn). TURN_SECRET, its shared secret, is a Worker secret. A name, not the IP:
  // ~/coturn/update-ip.py on the server (cron) keeps it, and coturn's external-ip, on the current public IP.
  "vars": { "TURN_HOST": "turn.claws.blue" }
}
